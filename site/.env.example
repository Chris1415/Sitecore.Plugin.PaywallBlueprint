# ============================================================================
# Paywall Blueprint — environment variables
# ============================================================================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is gitignored.
# ============================================================================

# --- Supabase (entitlement store) ---
# Get these from your Supabase project dashboard (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...   # service-role; never commit; never expose client-side

# --- Paywall behavior toggle ---
# When 'false', PaywallGate renders children verbatim + a 'Paywall disabled — demo mode'
# banner. Default (unset or 'true') = enforced mode (entitlement is evaluated).
NEXT_PUBLIC_PAYWALL_ENABLED=true

# --- Dev override (LOCAL DEV ONLY) ---
# When set AND matches the resolved host.user.sub AND NODE_ENV != production,
# PaywallGate short-circuits to 'allowed' WITHOUT calling the entitlement store.
# Compile-time guarded — Next.js tree-shakes the entire branch from production
# builds via the NODE_ENV !== 'production' check. Verified by `npm run test:dce`.
# Get your sub from the /debug probe page (or check host-user fixture).
# NEXT_PUBLIC_PAYWALL_DEV_OVERRIDE_USER_ID=auth0|<your-stable-auth0-sub>

# --- Stripe ---
# Added in PRD-001 (Tranche A T007). See README "Stripe Setup" section for instructions.

# Server-only; never expose client-side. Test mode keys start with sk_test_.
# Get from: Stripe Dashboard → Developers → API keys → Secret key.
STRIPE_SECRET_KEY=<your-stripe-test-secret-key>

# Client-readable (NEXT_PUBLIC_* is inlined into the client bundle by Next.js).
# Test-mode publishable key — safe to expose. Starts with pk_test_.
# Get from: Stripe Dashboard → Developers → API keys → Publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-test-publishable-key>

# Stripe Price ID for the €0.99 lifetime entitlement. Server-only reference; never exposed.
# Blueprint default: price_1TXHyIAHnDmxitZjwxHhKe8y (one-time €0.99 EUR, type: one_time).
# Adopters: replace with your own Price ID from Stripe Dashboard → Product Catalog.
STRIPE_PRICE_ID=<your-stripe-price-id>

# Server-only; verifies webhook signatures. Captured from `stripe listen` output during local dev.
# Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# The output line "Ready! Your webhook signing secret is whsec_..." — copy that value here.
# Production: set from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SIGNING_SECRET=<your-stripe-webhook-signing-secret>

# OPTIONAL: middle-tier override for the Stripe idempotency-key version segment.
# Three-tier precedence (highest wins):
#   1. UI — `?paywall_version=<value>` in the browser URL, or
#           `localStorage.setItem('paywall_version', '<value>')` in DevTools.
#           Operator-controllable, zero redeploy.
#   2. Env var — this STRIPE_CHECKOUT_PARAMS_VERSION variable. Set in Vercel /
#           hosting project settings; Vercel auto-redeploys on change (~30s).
#   3. Code default — CHECKOUT_PARAMS_VERSION in StripeProvider.ts (currently "v3").
# Bump this when stale Stripe idempotency cache blocks testing — e.g., after
# switching Sandbox <-> Live or after a SessionCreateParams shape change.
# See README "Idempotency key versioning" for the full mechanics.
# STRIPE_CHECKOUT_PARAMS_VERSION=v4
