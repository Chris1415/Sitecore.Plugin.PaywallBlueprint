# ============================================================================
# Paywall Blueprint — environment variables
# ============================================================================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is gitignored.
# ============================================================================

# --- Supabase (entitlement store) ---
# Get these from your Supabase project dashboard (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...   # service-role; never commit; never expose client-side

# --- Paywall behavior toggle ---
# When 'false', PaywallGate renders children verbatim + a 'Paywall disabled — demo mode'
# banner. Default (unset or 'true') = enforced mode (entitlement is evaluated).
NEXT_PUBLIC_PAYWALL_ENABLED=true

# --- Dev override (LOCAL DEV ONLY) ---
# When set AND matches the resolved host.user.sub AND NODE_ENV != production,
# PaywallGate short-circuits to 'allowed' WITHOUT calling the entitlement store.
# Compile-time guarded — Next.js tree-shakes the entire branch from production
# builds via the NODE_ENV !== 'production' check. Verified by `npm run test:dce`.
# Get your sub from the /debug probe page (or check host-user fixture).
# NEXT_PUBLIC_PAYWALL_DEV_OVERRIDE_USER_ID=auth0|<your-stable-auth0-sub>
